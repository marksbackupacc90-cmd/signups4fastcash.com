# HTTP listen port for the Express application.
PORT=3000

# Runtime mode: development, test, or production.
NODE_ENV=development

# Canonical public origin used for OAuth callbacks and self-referential links.
APP_URL=http://localhost:3000

# Comma-separated browser origins allowed by production CORS; defaults to APP_URL.
CORS_ORIGINS=http://localhost:3000

# PostgreSQL connection for users, wallets, offers, and all game tables.
# The current server uses one database URL; it has no separate user/game DB or file-path setting.
DATABASE_URL=postgresql://postgres:replace-with-local-password@localhost:5432/s4fc_dev

# Admin unlock passcode; use a long, unique secret outside local development.
ADMIN_PASSCODE=replace-with-a-long-random-admin-passcode

# Optional primary owner account email for owner-admin access.
OWNER_EMAIL=owner@example.com

# Optional comma-separated additional owner account emails.
OWNER_EMAIL_ALIASES=

# Lifetime in hours for in-memory admin unlock tokens (default 2; clamped to 0.25-24).
ADMIN_SESSION_HOURS=2

# Google OAuth web client ID; required to enable Google sign-in.
GOOGLE_CLIENT_ID=your_google_web_client_id

# Google OAuth web client secret; required to enable Google sign-in.
GOOGLE_CLIENT_SECRET=your_google_web_client_secret

# Optional stable HMAC secret for referral-related fraud hashes; falls back to GOOGLE_CLIENT_SECRET.
REFERRAL_HASH_SECRET=replace-with-a-long-random-referral-hash-secret

# Optional HMAC secret for fraud identifier hashing; falls back to referral or Google secret.
FRAUD_SECRET=replace-with-a-different-long-random-fraud-secret

# Optional comma-separated IP addresses to deny; built-in checks do not call a third-party VPN API.
FRAUD_DENY_IPS=

# Shared HMAC secret for the generic GET/POST affiliate callback at /api/v1/callbacks/postback.
POSTBACK_SECRET=replace-with-a-long-random-affiliate-postback-secret

# HMAC secret shared with the trusted provider sending signed offer milestone callbacks.
MILESTONE_CALLBACK_SECRET=replace-with-a-long-random-milestone-callback-secret

# CPX Research app identifier (the server defaults to 36089 if omitted).
CPX_APP_ID=36089

# CPX Research postback verification secret; required for CPX survey links and callbacks.
CPX_SECURE_HASH=replace-with-your-cpx-postback-secret

# Commission percentage for previously attributed affiliate referrals (default 10; range 0-100).
REFERRAL_COMMISSION_PERCENT=10

# Offer network payout multiplier (default 0.85; valid range greater than 0 through 1).
OFFER_HOUSE_PAYOUT_MULTIPLIER=0.85

# Optional JSON array/object of configured offer feed names and URLs; leave empty to disable.
OFFER_FEEDS_JSON=

# Optional comma-separated external offer feed URLs; leave empty to disable feed polling.
OFFER_FEED_URLS=

# Optional withdrawal-provider webhook URL; leave empty to keep webhook delivery disabled.
WITHDRAWAL_WEBHOOK_URL=

# HMAC signing secret for withdrawal webhooks; required when a webhook URL is configured.
WITHDRAWAL_WEBHOOK_SECRET=replace-with-a-long-random-withdrawal-webhook-secret

# Resend API key for account and newsletter email delivery.
RESEND_API_KEY=re_your_api_key

# Verified sender address configured with Resend.
EMAIL_FROM=Signups4FastCash.com <alerts@your-domain.com>

# Secret used to sign newsletter unsubscribe links; falls back to ADMIN_PASSCODE if omitted.
NEWSLETTER_UNSUBSCRIBE_SECRET=replace-with-a-long-random-newsletter-unsubscribe-secret

# Shared secret configured in the newsletter provider webhook settings.
NEWSLETTER_WEBHOOK_SECRET=replace-with-a-different-long-random-newsletter-webhook-secret

# Gemini API key for server-side CashBot/AI features.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Visitor event retention in days (default 365; clamped to 1-3650).
VISITOR_ANALYTICS_RETENTION_DAYS=365

# Reserved only: SESSION_SECRET is not read by the current server.
# Authentication uses random session tokens persisted in PostgreSQL and an HTTP-only cookie.
# SESSION_SECRET=replace-with-a-long-random-session-secret

# Reserved only: these proxy/VPN reputation API settings are not read or called by current server.ts.
# Configure only after implementing and reviewing a specific provider integration.
# PROXY_VALIDATION_API_URL=
# PROXY_VALIDATION_API_KEY=
# VPN_DETECTION_API_URL=
# VPN_DETECTION_API_KEY=

# Reserved only: current affiliate verification uses the shared POSTBACK_SECRET.
# The current server does not read provider-specific Lootably/Torox/Revlum credentials.
# LOOTABLY_POSTBACK_SECRET=
# LOOTABLY_CALLBACK_SALT=
# LOOTABLY_VALIDATION_TOKEN=
# TOROX_POSTBACK_SECRET=
# TOROX_CALLBACK_SALT=
# TOROX_VALIDATION_TOKEN=
# REVLUM_POSTBACK_SECRET=
# REVLUM_CALLBACK_SALT=
# REVLUM_VALIDATION_TOKEN=
